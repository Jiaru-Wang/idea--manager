# Optional persistent agent configuration. Core IdeaMiner needs no API key.
# The safer default is to enter connection details in the Agent panel per session.

IDEAMINER_AGENT_PROVIDER=openai
OPENAI_API_KEY=
IDEAMINER_OPENAI_MODEL=gpt-5.4-mini

# DeepSeek alternative:
# IDEAMINER_AGENT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# IDEAMINER_DEEPSEEK_MODEL=deepseek-v4-flash

# Optional custom OpenAI-compatible Responses API:
# IDEAMINER_AGENT_PROVIDER=custom
# IDEAMINER_AGENT_BASE_URL=http://127.0.0.1:1234/v1
# IDEAMINER_AGENT_MODEL=local-model
# IDEAMINER_AGENT_API_KEY=

