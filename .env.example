# Optional environment-based agent configuration. Core IdeaMiner needs no API key.
# The Agent page can instead remember a separate credential securely for each provider.

IDEAMINER_AGENT_PROVIDER=openai
OPENAI_API_KEY=
IDEAMINER_OPENAI_MODEL=gpt-5.6-luna

# Anthropic alternative:
# IDEAMINER_AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# IDEAMINER_ANTHROPIC_MODEL=claude-sonnet-5

# DeepSeek alternative:
# IDEAMINER_AGENT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# IDEAMINER_DEEPSEEK_MODEL=deepseek-flash

# Qwen alternative:
# IDEAMINER_AGENT_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# IDEAMINER_QWEN_MODEL=qwen3.8-flash

# Local OpenAI-compatible Responses API (key is optional):
# IDEAMINER_AGENT_PROVIDER=local
# IDEAMINER_AGENT_BASE_URL=http://127.0.0.1:11434/v1
# IDEAMINER_LOCAL_MODEL=gpt-oss:20b
# IDEAMINER_LOCAL_API_KEY=
